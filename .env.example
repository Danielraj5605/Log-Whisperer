# Log Whisperer — Environment Variables Template
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# (The .env file is gitignored and will never be committed.)
#
# Usage:
#   Windows:  copy .env.example .env   → then edit .env
#   Mac/Linux: cp .env.example .env    → then edit .env
#
# Alternatively, run:  logwhisper setup
# That will save your API key securely to the system config.
# ─────────────────────────────────────────────────────────────

# ── Gemini API Key (REQUIRED) ─────────────────────────────────
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Telegram Alerts (OPTIONAL) ───────────────────────────────
# To enable Telegram notifications, uncomment and fill these in.
# See README for step-by-step Telegram setup instructions.
# TELEGRAM_BOT_TOKEN=123456789:ABCdef_your_bot_token_here
# TELEGRAM_CHAT_ID=123456789
